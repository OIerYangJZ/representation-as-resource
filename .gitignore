# --- experiment data: 618M / 38k files, kept out of THIS repo ---
# data/ is its own git repository, backed up to the private
# github.com/OIerYangJZ/paper1-data (155M packed). It stays checked out here at
# data/ because the paths in its manifests are relative to this repo root.
# Frozen slices the paper cites are indexed by data/frozen/*_freeze_manifest.json.
data/

# vendored third-party compilers checked out for the round-6 baselines
# (they carry their own .git; re-clone per research/round6_major_revision/README)
research/round6_major_revision/tools/

# LaTeX build artifacts. Scoped to the top level of the two LaTeX dirs on
# purpose: a bare *.log would also swallow the ~150 experiment logs under
# PaperDraft/research/*/logs/ and research/round6_major_revision/logs/, which
# are provenance for the paper's tables. *.bbl and *.pdf are kept (arXiv).
PaperDraft/*.aux
PaperDraft/*.log
PaperDraft/*.blg
PaperDraft/*.fls
PaperDraft/*.fdb_latexmk
PaperDraft/*.out
PaperDraft/*.synctex.gz
PaperDraft/*.toc
AQIS26_Poster/*.aux
AQIS26_Poster/*.log
AQIS26_Poster/*.fls
AQIS26_Poster/*.fdb_latexmk
AQIS26_Poster/*.out
AQIS26_Poster/*.synctex.gz
AQIS26_Poster/*.toc

# locally compiled staq helpers (2.2M of arm64 Mach-O). The sources next to
# them and the sha256 records in environment_snapshot.json / *_frozen.json are
# committed, so provenance survives; drop these lines if you want the exact
# binaries in the artifact.
PaperDraft/research/*/tools/staq_grid_synth
PaperDraft/research/*/tools/staq_rotation_optimizer
PaperDraft/research/*/tools/staq_rotation_optimizer_macos_arm64

# local virtualenvs
.venv/
venv/
