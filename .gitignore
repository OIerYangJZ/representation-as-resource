# matplotlib/fontconfig caches written by scripts/build_all_figures.py
tmp/

# Only the frozen ucc snapshot files already committed are part of the
# artifact; anything new under ucc/ (or an upstream ucc-main/ checkout) is not.
ucc-main/
ucc/

# --- experiment data ---
# Only data/manifest.yaml, data/provenance_map.yaml, data/frozen/ and
# data/runs/w7-fixed-total-error-20260803-local/ are committed (force-added).
# Everything else under data/ -- notably the optional raw archive checked out
# at data/raw-archive/ by reproducibility/fetch_raw_data.sh -- stays out of
# this repository. New files under data/frozen/ need `git add -f`.
data/

# vendored third-party compilers checked out for the round-6 baselines
# (they carry their own .git; versions are recorded in
# research/round6_major_revision/PUBLIC_PHASE_FOLDING_BASELINE.md and
# round6_environment_snapshot.md)
research/round6_major_revision/tools/

# LaTeX build artifacts. Scoped to the top level of the two LaTeX dirs on
# purpose: a bare *.log would also swallow the ~150 experiment logs under
# PaperDraft/research/*/logs/ and research/round6_major_revision/logs/, which
# are provenance for the paper's tables. *.bbl and *.pdf are kept (arXiv).
PaperDraft/*.aux
PaperDraft/*.log
PaperDraft/*.blg
PaperDraft/*.fls
PaperDraft/*.fdb_latexmk
PaperDraft/*.out
PaperDraft/*.synctex.gz
PaperDraft/*.toc
AQIS26_Poster/*.aux
AQIS26_Poster/*.log
AQIS26_Poster/*.fls
AQIS26_Poster/*.fdb_latexmk
AQIS26_Poster/*.out
AQIS26_Poster/*.synctex.gz
AQIS26_Poster/*.toc
AQIS26_Poster/*.nav
AQIS26_Poster/*.snm

# The staq helpers below are committed macOS arm64 binaries (force-added; their
# sha256 is pinned in reproducibility/environment.lock and the frozen records).
# This rule only keeps locally rebuilt copies from being committed by accident.
PaperDraft/research/*/tools/staq_grid_synth
PaperDraft/research/*/tools/staq_rotation_optimizer
PaperDraft/research/*/tools/staq_rotation_optimizer_macos_arm64

# local virtualenvs
.venv/
venv/
