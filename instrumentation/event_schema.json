{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucc/reference-event-trace-v1.schema.json",
  "title": "UCC instrumented reference compiler event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_index",
    "event_kind",
    "input_position",
    "pass_index",
    "round_index",
    "side",
    "crossing",
    "status",
    "control_bytes",
    "store_bytes",
    "window_bytes",
    "parameter_bytes",
    "serialized_ir_bytes",
    "B_control_bits",
    "B_store_bits",
    "B_window_bits",
    "B_parameter_bits",
    "B_IR_bits",
    "B_cross_bits",
    "committed_output_bytes",
    "B_com_bits",
    "committed_delta_bytes",
    "committed_delta_bits",
    "current_output_length",
    "committed_prefix_sha256",
    "rss_bytes",
    "wall_time_ns",
    "slices",
    "details"
  ],
  "properties": {
    "schema": {"const": "ucc.reference-event-trace.v1"},
    "event_index": {"type": "integer", "minimum": 0},
    "event_kind": {"type": "string", "minLength": 1},
    "input_position": {"type": "integer", "minimum": 0},
    "pass_index": {"type": "integer", "minimum": 0},
    "round_index": {"type": ["integer", "null"], "minimum": 0},
    "side": {"enum": ["A", "B", "none"]},
    "crossing": {"enum": ["A_to_B", "B_to_A", null]},
    "status": {"type": "string", "minLength": 1},
    "control_bytes": {"type": "integer", "minimum": 0},
    "store_bytes": {"type": "integer", "minimum": 0},
    "window_bytes": {"type": "integer", "minimum": 0},
    "parameter_bytes": {"type": "integer", "minimum": 0},
    "serialized_ir_bytes": {"type": "integer", "minimum": 0},
    "B_control_bits": {"type": "integer", "minimum": 0},
    "B_store_bits": {"type": "integer", "minimum": 0},
    "B_window_bits": {"type": "integer", "minimum": 0},
    "B_parameter_bits": {"type": "integer", "minimum": 0},
    "B_IR_bits": {"type": "integer", "minimum": 0},
    "B_cross_bits": {"type": "integer", "minimum": 0},
    "committed_output_bytes": {"type": "integer", "minimum": 0},
    "B_com_bits": {"type": "integer", "minimum": 0},
    "committed_delta_bytes": {"type": "integer", "minimum": 0},
    "committed_delta_bits": {"type": "integer", "minimum": 0},
    "current_output_length": {"type": "integer", "minimum": 0},
    "committed_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rss_bytes": {"type": "integer", "minimum": 0},
    "wall_time_ns": {"type": "integer", "minimum": 0},
    "slices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "store", "window", "parameter", "ir"],
      "properties": {
        "control": {"$ref": "#/$defs/slice"},
        "store": {"$ref": "#/$defs/slice"},
        "window": {"$ref": "#/$defs/slice"},
        "parameter": {"$ref": "#/$defs/slice"},
        "ir": {"$ref": "#/$defs/slice"}
      }
    },
    "details": {"type": "object"}
  },
  "$defs": {
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "offset", "bytes", "bits", "sha256", "codec_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "offset": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "bits": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "codec_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
